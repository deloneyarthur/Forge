# forge-campaign.service — the weekly, zero-input challenger run (plan 2026-09 §12; D406/D409/D410).
# FORGE_CAMPAIGN_MODE is the ONE operator decision this unit carries:
#   dry-run — the dry-run weeks: snapshot DB, plan only, nothing submitted (installed 2026-09-14, D411)
#   live    — the Route C cutover (§12.6 Batch 4): real DB, real submissions. Flip it ONLY after the
#             daemon is stopped, Crucible's 14-day forge-scoped gated stream is live, and the cutover
#             instant has been relayed (D409). The wrapper refuses live mode while forge.service runs.
# No SuccessExitStatus on purpose: a refused mode, a failed boot check, contracts drift or a missing
# export leaves the unit FAILED — that is the operator's only page. Edit → daemon-reload.
[Unit]
Description=Forge weekly campaign run (challengers for the designated book; no operator input)
Documentation=file://%h/proj/Forge/docs/MANPAGE.md
After=network.target

[Service]
Type=oneshot
WorkingDirectory=%h/proj/Forge
Environment=FORGE_CAMPAIGN_MODE=live
ExecStart=%h/proj/Forge/scripts/campaign_run.sh
TimeoutStartSec=3h
# 26.7 GB peak measured 2026-09-15 on a dry-run WITH in-run training (Batch 5 G0: the verdict fit
# reads 1.27M verdict rows, the robustness fit 1.0M, on top of the cell stats + a 20k enumeration;
# 13.8 GB before training moved in). Fail this unit rather than starve Crucible (its services
# OOM'd twice, D399/D401). The dataset build is the Batch 6 memory target.
MemoryHigh=32G
MemoryMax=48G
StandardOutput=journal
StandardError=journal
SyslogIdentifier=forge-campaign
NoNewPrivileges=true
PrivateTmp=true
