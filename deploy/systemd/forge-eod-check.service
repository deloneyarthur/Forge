[Unit]
Description=Forge EOD pipeline check (headless Claude: DB snapshot vs clean-era baseline)
Documentation=file://%h/.local/bin/forge-eod-check.sh

[Service]
Type=oneshot
WorkingDirectory=%h/proj/Forge
ExecStart=%h/.local/bin/forge-eod-check.sh
TimeoutStartSec=30m
StandardOutput=journal
StandardError=journal
SyslogIdentifier=forge-eod-check
