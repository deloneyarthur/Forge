[Unit]
Description=Forge daily learned-verdict-model train + eval (F3 criterion clock)
Documentation=file://%h/proj/Forge/scripts/daily_ranker_eval.sh

[Service]
Type=oneshot
WorkingDirectory=%h/proj/Forge
ExecStart=%h/proj/Forge/scripts/daily_ranker_eval.sh
# Train on a ~10k-row frame is minutes of pure-Python IRLS; snapshot + eval add a
# little. Generous ceiling so a slow snapshot never wedges the timer.
TimeoutStartSec=30m
StandardOutput=journal
StandardError=journal
SyslogIdentifier=forge-ranker-eval
