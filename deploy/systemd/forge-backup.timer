[Unit]
Description=Trigger Forge weekly DR backup (after the Sunday campaign run)
Documentation=file://%h/proj/Forge/deploy/systemd/forge-backup.service

[Timer]
# Sunday 04:30 UTC: forge.db now changes only on the Sunday 03:00 UTC campaign run (its reconcile,
# verdicts, submissions and the in-run model training), so one copy a week after it is the whole
# DR story (Batch 5 G0, 2026-09-14; was nightly 04:00 local for the daemon).
# Persistent=true catches a run missed while the host was off.
OnCalendar=Sun *-*-* 04:30:00 UTC
Persistent=true
Unit=forge-backup.service

[Install]
WantedBy=timers.target
