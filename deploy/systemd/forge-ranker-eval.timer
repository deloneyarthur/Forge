[Unit]
Description=Trigger Forge daily learned-verdict-model train + eval
Documentation=file://%h/proj/Forge/deploy/systemd/forge-ranker-eval.service

[Timer]
# 05:00 local: a full overnight verdict window has decided, and well clear of the
# 03:00 prune, 06:00 digest, and 19:00 ingest (no colliding cp of the multi-GB DB).
# Persistent=true catches a run missed while the host was off.
OnCalendar=*-*-* 05:00:00
Persistent=true
Unit=forge-ranker-eval.service

[Install]
WantedBy=timers.target
