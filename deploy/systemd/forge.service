[Unit]
Description=Forge candidate strategy generator (Forge -> Crucible -> QuantIQ pipeline)
Documentation=file:///home/aj/proj/Forge/docs/DESIGN.md
After=network.target
Wants=network.target

[Service]
Type=simple
WorkingDirectory=/home/aj/proj/Forge
# --require-real-cache: skip the iteration if Crucible's writer/feature cache
# is unavailable rather than silently degrading to the synthetic cache and
# submitting a noise-filtered batch (2026-05-28 RCA / D080).
# --cohort-yield / --regime-gate-yield: §3/§2 of Crucible's 2026-06-17 yield-map
# refresh (D182/D183) — yield-drive the cohort + regime-gate draws. Default-off
# in code; ENABLED here. Remove either flag to revert that axis to a
# byte-identical draw (the A/B kill switch; hard rule #6).
# --quality-rank: the wf_p25 quality lane (D193) — BLEND the predicted WF-floor
# robustness into the §6.2 prior (prior := P(component) x tail_norm). Default-off in
# code; ENABLED here. Needs F3's P(component) base (the blend multiplies it) + a
# target_wf_p25 model in ~/forge_data/models (the daily timer publishes it). Env
# kill-switch FORGE_QUALITY_RANKER=off; remove the flag to revert byte-identical.
# FORGE_ORTHOGONAL_FAMILY_FLOOR (D216 Layer-2): floor single-name volatility_event's
# learned hypothesis weight to 0.20 (max semantics — starves nothing), lifting its
# sampling share ~2.9%->~10.7% so assembly has more of the PBO-orthogonal family
# (Crucible-validated 2026-06-29: PC1 load 0.10, mixed book CSCV PBO 0.107). A/B
# feedback knob; empty/unset => byte-identical (hard rule 6). REVERT = delete this
# line + restart. Pre-registered (D208) + alpha-budget-charged (D207); confirm §8.4.
Environment=FORGE_ORTHOGONAL_FAMILY_FLOOR=volatility_event=0.20
# FORGE_QUALITY_RANK_MODE=gate-tail (D252, prereg 9063b405): the P1.1 hard-gate form of the
# quality lane — P(component) GATES eligibility at FORGE_REWIRE_P_FLOOR and the wf_p25 tail
# ORDERS the survivors (the §6.2 composite is bypassed), matching the shadow A/B (Δ +0.180
# CI [+0.060,+0.309]; flip gate MET, fresh-PASS streak 6/3 at flip time). Default 'blend' in
# code = the D193 blend above; this env selects the re-wire. Requires --quality-rank (the lane
# must be ON). REVERT = delete these two lines + daemon-reload + restart (byte-identical to blend).
Environment=FORGE_QUALITY_RANK_MODE=gate-tail
Environment=FORGE_REWIRE_P_FLOOR=0.02
# FORGE_EXPLORATION_HOLDOUT_FRAC (D256, prereg 61837dd2): reserve ~5% of each batch as a
# SEEDED RANDOM draw from the prefilter-survivors the ranker did NOT pick — it REPLACES rank
# slots (total submitted unchanged), tagging those rows selection_mode='holdout'. Breaks the
# censored feedback loop: the F3/wf_p25/estimand models otherwise only ever get labels for
# configs they already scored high (esp. under gate-tail), so they can't learn where they're
# wrong. The unbiased labels also stand up a ranker-vs-random A/B (ranked vs holdout
# component-rate). Clamped to [0, 0.10]; empty/unset => byte-identical (hard rule 6). REVERT =
# delete this line + daemon-reload + restart.
Environment=FORGE_EXPLORATION_HOLDOUT_FRAC=0.05
# D335 prefilter-sample two-arm campaign — ACTIVATED 2026-07-23, TIME-BOX ~2026-08-13
# (2-3wk per Crucible's condition; operator removes this line to end it). Submits N
# uniform-random prefilter-REJECTED configs/batch tagged selection_arm='prefilter_sample'
# — the ONLY population unselected by both prefilter and ranker, the grammar-honest
# estimate the freeze criterion reads. On forge.service (the DAEMON/submit path), NOT the
# trainer unit. RAMPED to N=300 for ONE OVERNIGHT WINDOW (2026-07-24 ~18:45 PDT, operator:
# "ramp to 300 so we have something in the morning, then down to 40"), to accrue v50's own
# honest cohort beside the v49 baseline (n=302). ⚠️ REVERT TO 40 IN THE MORNING — at N=300
# the batch is 200+300=500 against the 600 in-flight cap, so backpressure throttles the whole
# stream and RANKED PRODUCTION DROPS ~70%. That price is deliberate overnight and wrong by day.
# Target: ~12h at ~30-35/hr = ~360-420 honest configs, enough to resolve prereg b13b0f893a11
# (the k=5-vs-k=10 trend gap) — note the v50 bias itself makes k=10 only 25% of trend draws,
# so the arm that VALIDATES the change is the scarce one and sets the n requirement.
# Steady-state target is N=40 (Crucible's power target, ~11% ranked cost, batch 240 well
# under the cap). MEASURE-AND-ADJUST: the N->accrual mapping is coupled through backpressure.
Environment=FORGE_PREFILTER_SAMPLE_N=300
# FORGE_YOUNG_CELL_FLOOR=on (D312; built flag-off at D307): the young-CELL exploration
# floor — diversifier phase 0c reserves <=2 slots/batch for any (directional, regime)
# cell with <25 honest-era verdicts (ghost-cut applied; hand-pinned campaign cells
# exempt; cap 10% of batch). The D287 protection made automatic: a novel pair cannot
# be starved at selection even when both its arms are individually mature. Must be
# exactly "on"; anything else = byte-identical (hard rule 6). REVERT = delete these
# two lines + daemon-reload + restart. Journal line when active: `cell_floor: ...`.
Environment=FORGE_YOUNG_CELL_FLOOR=on
ExecStart=/home/aj/.local/bin/uv run forge run --loop --consume-feedback --require-real-cache --cohort-yield --regime-gate-yield --quality-rank
Restart=on-failure
RestartSec=30
TimeoutStopSec=120
StandardOutput=journal
StandardError=journal
SyslogIdentifier=forge

# Conservative hardening for a personal single-user service.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
