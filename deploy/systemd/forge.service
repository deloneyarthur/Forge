# forge.service — the Forge daemon (Forge -> Crucible -> QuantIQ). Live unit: symlinked from
# ~/.config/systemd/user/. Edit only via docs/tasks/deploy.md (daemon-reload REQUIRED after any
# change, else the old unit starts). Directive rationale = one ⚠️ line each below; the history
# behind every value lives in its D-entry (this file stopped being a second decision ledger on
# 2026-09-13, repo-simplification Batch 1 / D407). Retired knobs, for the record:
#   FORGE_ORTHOGONAL_FAMILY_FLOOR — D216 Layer-2 ve floor, RETIRED D367 (evidence retracted; restore
#   with `Environment=FORGE_ORTHOGONAL_FAMILY_FLOOR=volatility_event=0.20` + restart if the freeze
#   leg-2 TCM-corr rises >0.0173 above 0.4457, prereg d4b1efd26bb3).
# Final state (plan §12): this unit is retired at the Route C cutover in favour of a weekly
# forge-campaign.timer.

[Unit]
Description=Forge candidate strategy generator (Forge -> Crucible -> QuantIQ pipeline)
Documentation=file:///home/aj/proj/Forge/docs/DESIGN.md
After=network.target
Wants=network.target

[Service]
Type=simple
WorkingDirectory=/home/aj/proj/Forge
# gate-tail (D252): P(component) gates at FORGE_REWIRE_P_FLOOR, wf_p25 tail orders (composite bypassed). Needs --quality-rank. ⚠️ REVERT = delete these two lines + daemon-reload + restart (byte-identical to blend).
Environment=FORGE_QUALITY_RANK_MODE=gate-tail
Environment=FORGE_REWIRE_P_FLOOR=0.02
# D256: ~5% of each batch = seeded random draw from unranked survivors (selection_mode='holdout'), clamp [0, 0.10]. ⚠️ unset = byte-identical; REVERT = delete + daemon-reload + restart.
Environment=FORGE_EXPLORATION_HOLDOUT_FRAC=0.05
# D335: N uniform-random prefilter-REJECTS/batch (selection_arm='prefilter_sample'), the honest arm. Steady state 40 (ramp history: D335/D351/D355/D359). ⚠️ A ramp is time-boxed to ONE question and reverts to 40 when it resolves — at N=300 ranked production drops ~70%.
Environment=FORGE_PREFILTER_SAMPLE_N=40
# D312 (built D307): diversifier reserves <=2 slots/batch per young (directional, regime) cell, cap 10%. Must be exactly "on". ⚠️ REVERT = delete + daemon-reload + restart.
Environment=FORGE_YOUNG_CELL_FLOOR=on
# prereg 8cfe95f4a6e9 (2026-07-27): tail arm, 95 slots ordered by the train-tail artifact (selection_mode='tail_lane'); the merit lane is the concurrent control. ⚠️ unset/0 = byte-identical; no artifact = inert.
Environment=FORGE_TAIL_LANE_SLOTS=95
# prereg 8cfe95f4a6e9 (trend leg, 2026-07-30): 40 slots from trend_continuation only (the candidate filter is load-bearing, b17ce39). ⚠️ unset/0 = byte-identical.
Environment=FORGE_TREND_LANE_SLOTS=40
# D341 Tier-1 generation A/B, CLOSED D351 (prereg 4e369b779ca9 REFUTED): 0 = no arm coin, no rng, no generation_arm stamp. Plumbing is scheduled for removal (repo-simplification 2026-09, Batch 5).
Environment=FORGE_GENERATION_ARM_B_SHARE=0
# --require-real-cache: skip the iteration rather than degrade to the synthetic cache (D080). --cohort-yield/--regime-gate-yield: D182/D183 yield axes, default-off in code. --quality-rank: the wf_p25 quality lane (D193), kill-switch FORGE_QUALITY_RANKER=off. ⚠️ Removing any flag reverts that axis byte-identically (hard rule #6).
ExecStart=/home/aj/.local/bin/uv run forge run --loop --consume-feedback --require-real-cache --cohort-yield --regime-gate-yield --quality-rank
Restart=on-failure
RestartSec=30
TimeoutStopSec=120
StandardOutput=journal
StandardError=journal
SyslogIdentifier=forge
# Conservative hardening for a personal single-user service.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
