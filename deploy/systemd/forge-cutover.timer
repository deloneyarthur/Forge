# Fires ONCE at the instant relayed to Crucible (D413): 2026-09-15T07:00:00Z. Persistent=true so a
# reboot before the instant fires it on the next boot, never earlier. Armed by the operator
# (`ln -sf` both forge-cutover units into ~/.config/systemd/user, `daemon-reload`, `enable --now`);
# disarmed by the script when done. Retire both files in Batch 5.
[Unit]
Description=Trigger the Forge Route C cutover at the relayed instant (D413)
Documentation=file://%h/proj/Forge/deploy/systemd/forge-cutover.service

[Timer]
OnCalendar=2026-09-15 07:00:00 UTC
Persistent=true
Unit=forge-cutover.service

[Install]
WantedBy=timers.target
